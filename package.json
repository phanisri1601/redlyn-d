{
  "name": "redlyn-rebuild",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run build:assets && next dev",
    "build": "npm run build:assets && next build",
    "test": "node --test tests/*.test.mjs",
    "build:vercel": "node scripts/migrate-turso.mjs --if-configured && npm run build",
    "db:migrate": "node scripts/migrate-turso.mjs",
    "test:firebase": "node scripts/test-firebase.mjs",
    "firebase:check": "node --env-file=.env scripts/check-firebase.mjs",
    "build:assets": "node scripts/build-next-assets.mjs",
    "start": "next start"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.1",
    "drizzle-orm": "^0.45.3",
    "firebase-admin": "^14.5.0",
    "html2canvas": "^1.4.1",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vercel/routing-utils": "^6.6.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}
